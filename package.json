{
  "name": "limited-underground-trail-server",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "test:docs": "node tools/check-doc-links.mjs",
    "test:host-profile": "node deploy/host/test-static.mjs",
    "test:server-service": "node deploy/app/test-static.mjs",
    "test:radio-contract": "dotnet run --project server/TrailServer.RadioContract.SimulatorTests/TrailServer.RadioContract.SimulatorTests.csproj --configuration Release",
    "test:radio-bridge": "dotnet run --project server/TrailServer.RadioBridge.SimulatorTests/TrailServer.RadioBridge.SimulatorTests.csproj --configuration Release",
    "test": "npm run lint && npm run test:docs && npm run test:host-profile && npm run test:server-service && npm run test:radio-contract && npm run test:radio-bridge && npm run build"
  },
  "dependencies": {
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.2",
    "@cloudflare/workers-types": "5.20260831.1",
    "@openai/sites-vite-plugin": "^0.1.0 || ^0.2.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.19.19",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.34",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.3",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.8",
    "vite": "8.2.2",
    "wrangler": "4.127.1"
  },
  "type": "module"
}
